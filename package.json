{
  "name": "food-log-export-kit",
  "version": "0.1.19",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "build:site": "tsc --noEmit && vite build",
    "build:app": "tsc --noEmit && vite build --outDir dist/app",
    "native:prereqs": "node scripts/linux-native-prereqs.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:site": "node scripts/release-site.mjs",
    "tauri": "node scripts/tauri.mjs",
    "test": "vitest run && playwright test",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-fs": "2.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.3.0",
    "typescript": "5.9.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
